# ══════════════════════════════════════════════════
# BOT ASOSIY SOZLAMALAR
# ══════════════════════════════════════════════════

# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin ID lar (vergul bilan ajratiladi, bo'shliqsiz)
ADMIN_IDS=123456789,987654321

# Railway PostgreSQL URL (Railway dashboard dan olinadi)
DATABASE_URL=postgresql://postgres:password@host.railway.app:5432/railway

# ══════════════════════════════════════════════════
# MAJBURIY KANAL
# ══════════════════════════════════════════════════
CHANNEL_ID=-1001234567890
CHANNEL_USERNAME=@kanalim

# ══════════════════════════════════════════════════
# TO'LOV VA VIP SOZLAMALAR
# ══════════════════════════════════════════════════

# To'lov kartasi
CARD_NUMBER=8600 0000 0000 0000
CARD_OWNER=Ism Familiya

# VIP narxi (so'mda)
VIP_PRICE=20000

# Bepul VIP uchun talab qilinadigan referal soni
VIP_REF_COUNT=7

# VIP muddati (oyda, masalan 1 = 30 kun)
VIP_MONTHS=1

# ══════════════════════════════════════════════════
# BALL TIZIMI
# ══════════════════════════════════════════════════

# Har bir referal (do'st taklif) uchun ball
REFERRAL_BONUS=200

# So'z o'rganish uchun ball (birinchi marta)
WORD_LEARN_BONUS=2

# Test to'g'ri javobi uchun ball (asosiy)
TEST_SCORE_BONUS=10

# Daraja bo'yicha test ball (beginner,intermediate,advanced)
LEVEL_TEST_BONUS=5,20,35

# So'rovnoma tugatganda beriladigan ball
SURVEY_BONUS=500

# ══════════════════════════════════════════════════
# PUL YUTUG'I SOZLAMALAR
# ══════════════════════════════════════════════════

# Sovrin uchun yig'ish kerak bo'lgan ball miqdori
PRIZE_BALL_TARGET=10000

# Sovrin miqdori (so'mda)
PRIZE_SCORE_AMOUNT=10000

# Sovrin olish uchun minimal referal soni
PRIZE_MIN_REFERRAL=1

# ══════════════════════════════════════════════════
# HAFTALIK REFERAL O'YINI
# ══════════════════════════════════════════════════

# Haftalik g'olib sovrin (so'mda)
PRIZE_REF_AMOUNT=10000

# Haftalik bonus uchun minimal referal soni
MIN_REFERRALS_FOR_BONUS=5

# Haftalik bonus to'lovi (so'mda)
WEEKLY_BONUS_PRICE=10000

# ══════════════════════════════════════════════════
# BELLASHUV (DUEL) SOZLAMALAR
# ══════════════════════════════════════════════════

# Bellashuvdagi savollar soni
BATTLE_QUESTION_COUNT=20

# Har savol uchun vaqt (sekundda)
BATTLE_TIMEOUT=20

# G'olibga beriladigan ball
BATTLE_WIN_BALL=50

# Mag'lubdan ayiriladigan ball (musbat son kiriting)
BATTLE_LOSE_BALL=50

# Bellashuvdan qochib ketganga ayiriladigan ball (musbat son)
BATTLE_LEAVE_BALL=100

# Do'st bellashuvida chiqib ketganga ball (0 = yo'q)
BATTLE_FRIEND_LEAVE=0
